# 호스트에서 uvicorn을 직접 실행할 때 쓰는 환경변수.
# DB/Redis는 docker/docker-compose.yml로 띄운 컨테이너를 "localhost" 포트로 접속한다.
#
# --- MySQL Workbench로 직접 접속하기 ---
# docker/docker-compose.yml의 mysql 서비스가 3306 포트를 호스트에 그대로 열어두므로,
# 아래 DATABASE_URL과 동일한 값으로 Workbench에서도 바로 접속할 수 있다.
#   Hostname: 127.0.0.1   Port: 3306
#   Username: devtrouble   Password: devtrouble   Default Schema: devtrouble
#   (전체 권한이 필요하면 Username: root   Password: root)
# "Authentication plugin 'caching_sha2_password' cannot be loaded" 에러가 뜨면
# 접속창에서 "Get Server Public Key"를 승인하거나 SSL을 끄면 된다 (MySQL 8 기본 인증 방식).

# --- App ---
ENV=local
DEBUG=true

# --- Database ---
DATABASE_URL=mysql+pymysql://devtrouble:devtrouble@localhost:3306/devtrouble
DATABASE_POOL_SIZE=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AWS (지금은 AWS에 배포하지 않으므로 비워둬도 된다) ---
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=

# --- Vector DB / AI ---
# VECTOR_DB_PROVIDER: faiss(기본값, 메모리, 재시작하면 사라짐) | chroma(로컬 파일 영속) | qdrant(별도 서버 필요)
VECTOR_DB_PROVIDER=faiss
QDRANT_URL=
QDRANT_COLLECTION_NAME=trouble_documents
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=trouble_documents

# AI_PROVIDER: local(기본값, API 키 없이 오프라인 폴백) | openai | watsonx
# local이 아닌 값을 선택하면 아래 해당 벤더의 값도 채워야 한다.
AI_PROVIDER=local

OPENAI_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-3-small
LLM_MODEL_NAME=gpt-4o-mini

# --- IBM watsonx.ai (AI_PROVIDER=watsonx 일 때만 사용) ---
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_EMBEDDING_MODEL_ID=ibm/granite-embedding-107m-multilingual
WATSONX_EMBEDDING_DIMENSION=384
WATSONX_LLM_MODEL_ID=meta-llama/llama-3-3-70b-instruct

RAG_TOP_K=5

# 검색 결과가 빈약하면 질문을 재구성해 재시도한다 (LangGraph 루프). 0이면 재시도 없음.
RAG_MAX_RETRIEVAL_ATTEMPTS=1
RAG_RETRY_SCORE_THRESHOLD=0.05
RAG_KEYWORD_MATCH_SCORE=0.5

# 멀티턴 후속 질문("그럼 그건요?")을 독립 질문으로 압축할지 (history가 있을 때만 동작).
RAG_ENABLE_QUERY_CONDENSATION=true

# 비용 절감: classify/rerank/validate 단계의 LLM 호출을 개별적으로 끌 수 있다.
RAG_ENABLE_CLASSIFY=true
RAG_ENABLE_RERANK=true
RAG_ENABLE_VALIDATION=true

# 재랭킹 벤더: llm(기본값, 일반 채팅 LLM에게 순서를 물어봄) | cohere(전용 재랭킹 모델)
RERANK_PROVIDER=llm
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# LangSmith(관측성) — true로 켜면 LangChain/LangGraph 호출이 전부 대시보드에 자동 기록된다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=devtrouble-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Context Caching — classify/rerank/validate/질문압축/임베딩 결과를 캐싱해 반복 호출을 줄인다.
# CONTEXT_CACHE_BACKEND: memory(기본값, 프로세스 로컬) | redis(이미 쓰는 Celery Redis 재사용,
# 여러 API 서버/워커가 캐시를 공유하고 싶을 때 — 운영 환경에 권장)
CONTEXT_CACHE_ENABLED=true
CONTEXT_CACHE_BACKEND=memory
CONTEXT_CACHE_TTL_SECONDS=3600

# --- Logging ---
LOG_LEVEL=INFO
